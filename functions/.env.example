# Copy to functions/.env (gitignored). Names only. Do not commit values.
#
# How vars reach the code:
# 1) functions/.env on disk. src/init-env.ts loads .env then .env.local on cold start.
# 2) Emulator. firebase emulators:start also merges functions/.env and .env.local.
# 3) Production. From the machine that has functions/.env, run firebase deploy --only functions.
#    The CLI applies the values to Cloud Functions. The file itself is not uploaded.
#
# Every name below is read by functions/src. Empty means unset.

# Stripe
STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=

# Set to the string true to allow logged-out landing checkout. Only used when STRIPE_MODE is test.
ENABLE_LANDING_GUEST_CHECKOUT=

